{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hb:schema:prices:1",
  "title": "Price table (results repository)",
  "description": "Dated per-token prices used to derive cost at display time. Kept outside the suite, so a price change never changes a cohort. Integer micro-dollars avoid floats.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "currency", "entries"],
  "properties": {
    "schema": {
      "const": "hb/prices/1"
    },
    "currency": {
      "const": "USD"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model_id", "as_of", "input_micros_per_mtok", "cached_input_micros_per_mtok", "output_micros_per_mtok"],
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "model_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]{1,128}$"
          },
          "as_of": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "input_micros_per_mtok": {
            "$ref": "urn:hb:schema:common:1#/$defs/uint"
          },
          "cached_input_micros_per_mtok": {
            "$ref": "urn:hb:schema:common:1#/$defs/uint"
          },
          "output_micros_per_mtok": {
            "$ref": "urn:hb:schema:common:1#/$defs/uint"
          }
        }
      }
    }
  }
}
